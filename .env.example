# Copy to .env (gitignored) to override settings locally, or set these in the
# Render dashboard for production. Local dev and tests need NONE of these.
# Full reference: doc/wiki/deployment.md

# Which settings module to load: config.settings.dev | config.settings.test | config.settings.prod
# (manage.py defaults to dev; wsgi.py/asgi.py and build.sh default to prod)
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Required in production ---
# Long random string. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Comma-separated hostnames, e.g. whatsup.onrender.com (Render's own hostname is added automatically)
ALLOWED_HOSTS=
# Neon Postgres connection string (pooled), e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Unset locally → SQLite (db.sqlite3)
DATABASE_URL=
# Cloudinary "API environment variable": cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- Optional ---
# Defaults: False in production, True in local dev
DEBUG=
# gunicorn worker processes on Render (recommend 2 on the free 512 MB instance)
WEB_CONCURRENCY=2
# First admin account, created by build.sh only if it doesn't exist yet
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# Run the test suite against Postgres instead of SQLite (opt-in; never use the production database)
TEST_DATABASE_URL=

# SMTP (not used yet; needed once the app sends email)
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
